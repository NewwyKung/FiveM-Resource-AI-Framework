{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fivem-resource/ai-task.schema.json",
  "title": "Compact AI task envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "intent", "phase", "characteristics", "references", "scope", "acceptanceCriteria", "validation"],
  "properties": {
    "schema": { "const": "ai-task/v1" },
    "intent": {
      "enum": [
        "resource.create",
        "feature.add",
        "feature.change",
        "bug.fix",
        "refactor",
        "review",
        "release",
        "integration.register",
        "integration.activate",
        "ui.design",
        "ui.implement",
        "framework.harden"
      ]
    },
    "phase": {
      "enum": ["discovery", "design", "implementation", "review", "release"]
    },
    "characteristics": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "networkOperation",
          "economicMutation",
          "persistentMutation",
          "retainedPlayerState",
          "entityOperation",
          "asyncRequest",
          "stateBag",
          "nui",
          "externalProvider",
          "localization",
          "assets",
          "publicApi"
        ]
      }
    },
    "references": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requirement": { "type": ["string", "null"] },
        "feature": { "type": ["string", "null"] },
        "skill": { "type": ["string", "null"] },
        "rules": { "$ref": "#/$defs/uniquePaths" },
        "decisions": { "$ref": "#/$defs/uniquePaths" },
        "providers": { "$ref": "#/$defs/uniquePaths" },
        "specifications": { "$ref": "#/$defs/uniquePaths" },
        "example": { "type": ["string", "null"] }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["include", "exclude"],
      "properties": {
        "include": { "$ref": "#/$defs/uniquePaths" },
        "exclude": { "$ref": "#/$defs/uniquePaths" }
      }
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "validation": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "uniquePaths": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
