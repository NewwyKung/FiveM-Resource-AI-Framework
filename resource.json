{
  "schemaVersion": 1,
  "name": "v.2-Template-FiveM",
  "type": "fivem-resource-template",
  "author": "Newwy",
  "version": "1.0.0",
  "framework": {
    "mode": "standalone",
    "optionalBridges": ["esx", "qbcore"]
  },
  "runtime": {
    "client": true,
    "server": true,
    "shared": true,
